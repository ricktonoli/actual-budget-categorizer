# Actual Budget Configuration
# These environment variables are required to connect to your Actual Budget instance

# The server hostname or IP (e.g., budget.tonoli.net or 192.168.10.53)
AB_SERVER=192.168.10.53

# Port for Actual Budget server (default: 5006)
AB_PORT=5006

# Whether to use HTTPS (default: true)
AB_USE_HTTPS=true

# Your Actual Budget password
AB_PASSWORD=your_password_here

# Your Actual Budget encryption password (if you have one configured)
AB_ENCRYPTION_PASSWORD=your_encryption_password_here

# Optional: Where Actual stores downloaded budgets (default: ./.actual-data)
AB_DATA_DIR=/path/to/actual-data

# Optional: Port for the categorizer web UI (default: 3001)
PORT=3001
